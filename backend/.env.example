# ==========================================
# AegisAI Backend Environment Example
# ==========================================

APP_NAME=AegisAI Enterprise Platform
DEBUG=False
API_PREFIX=/api/v1

# Relational Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:secure_password_123@localhost:5432/aegisai_db

# Redis Cache and Token Blacklist
REDIS_URL=redis://:redis_password_123@localhost:6379/0

# Apache Kafka Event Streaming Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Vector Storage Configuration ("chroma" or "pinecone")
VECTOR_DB_PROVIDER=chroma
CHROMA_DB_DIR=storage/chromadb
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=aegisai-index

# Storage
UPLOAD_DIR=storage/documents

# LLM Providers (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# JWT Authentication Secrets
JWT_SECRET_KEY=generate_random_secret_for_production
JWT_REFRESH_SECRET_KEY=generate_random_refresh_secret_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

